        {
          "id": "0fb70ad5-6f89-4e9b-8a51-907f78d0423c",
          "name": "Create or update a study schedule",
          "request": {
            "name": "Create or update a study schedule",
            "description": {
              "content": "Creates a new schedule for the study if one doesn't exist, or updates the existing schedule. The study must belong to the authenticated user. When enabled, next_scheduled_run is set to now plus the repeat interval. When disabled, next_scheduled_run is cleared.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "study-schedules",
                ":study_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "study_id",
                  "description": "(Required) The UUID of the study to schedule"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": \"<boolean>\",\n  \"repeat_interval\": \"<integer>\"\n}",
